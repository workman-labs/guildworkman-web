# Copy to .env.local and fill in real values locally. Never commit .env.local.
# Next.js only exposes vars prefixed NEXT_PUBLIC_ to the client bundle.

# Base URL of the GuildWorkman API. Defaults to the hosted instance if unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Stellar network the wallet-connection layer expects Freighter to be on.
# One of PUBLIC | TESTNET | FUTURENET. Defaults to TESTNET if unset, matching
# the Soroban contracts' current deployment target.
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
